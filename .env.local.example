# ============================
# StreamFlix — Environment Template
# ============================
# Copy to .env.local and fill in real values.
# Only NEXT_PUBLIC_* variables are exposed to the browser.

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ---------- Firebase (public config — safe to expose) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------- Firebase Admin (server only) ----------
# Paste the FULL service-account JSON as a single-line string, or set
# GOOGLE_APPLICATION_CREDENTIALS to a service-account file path.
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ---------- JWT (server only) ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------- Cloudinary (server only) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=streamflix
#   Test the full pipeline: node scripts/verify-upload.mjs

# ---------- Redis (optional, server only) ----------
REDIS_URL=redis://localhost:6379

# ---------- Payments (optional, server only) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---------- Email (optional, server only) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=StreamFlix <no-reply@streamflix.dev>

# ---------- AI features (optional, server only) ----------
OPENAI_API_KEY=
ASSEMBLYAI_API_KEY=

# ---------- Google Analytics (optional, public) ----------
NEXT_PUBLIC_GA_ID=

# ---------- Admin (used by demo login) ----------
DEMO_ADMIN_EMAIL=admin@streamflix.dev
DEMO_ADMIN_PASSWORD=Demo123456!

# ---------- Demo mode (optional) ----------
# Demo login (the "Demo User / Demo Admin" buttons) works automatically in
# development. In PRODUCTION it is disabled by default for security; set this
# to true only if you want the demo buttons to work on the live site too.
NEXT_PUBLIC_ENABLE_DEMO_AUTH=false
