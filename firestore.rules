rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTeacher() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'teacher'];
    }

    // ---------- Users ----------
    match /users/{userId} {
      allow read: if isSignedIn();
      // A user can create/update their own profile; only admins modify roles or bans.
      // The key whitelists below must match exactly what src/lib/auth-store.ts
      // (createUserDocument) writes — see that file before changing them.
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role == 'user' &&
        request.resource.data.isBanned == false &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'role', 'emailVerified',
          'isBanned', 'subscription', 'createdAt', 'lastLoginAt',
          'preferences', 'stats'
        ]);
      allow update: if (isAdmin() && request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'banned', 'banReason', 'storageUsed', 'isBanned'])) ||
        (isSignedIn() && request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoURL', 'bio', 'lastLoginAt',
              'preferences', 'stats', 'emailVerified', 'subscription', 'phoneNumber']));
      allow delete: if isAdmin();
    }

    // ---------- Videos ----------
    match /videos/{videoId} {
      // Everyone can read public/unlisted; private requires the owner.
      allow read: if isSignedIn() && (
        resource.data.visibility == 'public' ||
        resource.data.visibility == 'unlisted' ||
        resource.data.ownerId == request.auth.uid ||
        isTeacher()
      );
      allow create, update, delete: if isTeacher();
    }

    // ---------- Categories ----------
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- Comments ----------
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 2000;
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['text', 'updatedAt', 'likes', 'dislikes', 'emojiReactions'])) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ---------- Watch history / progress ----------
    match /watchProgress/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ---------- My list / favorites ----------
    match /myList/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ---------- Notifications ----------
    match /notifications/{notificationId} {
      allow read, update: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
      allow create: if isTeacher();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ---------- Subscriptions ----------
    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- Analytics (admin only) ----------
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- Live streams ----------
    match /liveStreams/{streamId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }

    // ---------- Upload sessions ----------
    match /uploadSessions/{sessionId} {
      allow read, write: if isSignedIn() &&
        (resource == null || resource.data.userId == request.auth.uid || isTeacher());
    }
  }
}
